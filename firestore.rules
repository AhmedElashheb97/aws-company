rules_version = '2';
// Office users (signed in) read and write cars, customers and settings.
// tracking/{VIN}: anyone can open one car by its VIN (customer tracking page), but cannot list them.
// log: signed-in users can add entries under their own email and read them; nobody can edit or delete them.
// Paste into Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{id} { allow read, write: if request.auth != null; }
    match /customers/{id} { allow read, write: if request.auth != null; }
    match /meta/{id} { allow read, write: if request.auth != null; }
    match /tracking/{vin} { allow get: if true; allow list, write: if request.auth != null; }
    match /log/{id} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.by == request.auth.token.email; }
  }
}
