rules_version = '2';
// Office users (signed in) can read and write everything.
// tracking/{VIN}: anyone can open one car by its VIN (the customer tracking page), but cannot list them.
// Paste into Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /tracking/{vin} {
      allow get: if true;
    }
  }
}
